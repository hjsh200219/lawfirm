{
  "_note": "런타임이 읽는 응답 키 목록 — 받는 PC 의 형식 검사(lawapi·casesearch)와 개발 PC 의 계약 점검(dev/contract.py)이 같은 파일을 읽는다. required 는 항목 필수 키(없으면 형식 변경), keys 는 계약 점검 비교 키. 빅케이스 case(match_view) 필수 키는 로컬 녹화로 최상위 키를 잰 뒤 정한다 — 그 전에는 null(검사 끔).",
  "law": {
    "law_search": {"path": "lawSearch.do", "target": "law", "container": "LawSearch", "list": "law", "count": "totalCnt",
                   "required": ["법령명한글", "법령ID"],
                   "keys": ["법령명한글", "법령약칭명", "현행연혁코드", "법령ID", "법령일련번호", "시행일자"]},
    "article": {"path": "lawService.do", "target": "law", "container": "법령",
                "keys": ["조문", "조문단위", "조문내용", "조문여부", "조문제목", "조문시행일자", "항", "항내용", "호", "호내용", "목", "목내용", "조문번호"]},
    "prec_search": {"path": "lawSearch.do", "target": "prec", "container": "PrecSearch", "list": "prec", "count": "totalCnt",
                    "required": ["판례일련번호", "사건번호"],
                    "keys": ["판례일련번호", "사건번호", "법원명", "선고일자", "사건명", "판결유형", "사건종류명"]},
    "prec": {"path": "lawService.do", "target": "prec", "container": "PrecService",
             "keys": ["사건번호", "법원명", "선고일자", "사건명", "판결유형", "판시사항", "판결요지", "참조조문", "참조판례", "판례내용"]}
  },
  "bigcase": {
    "search": {"list": "results", "count": "total", "required": ["case_number", "court"],
               "keys": ["result_count", "results", "case_id", "case_expression", "case_number", "court", "case_type", "outcome", "level"]},
    "similar": {"list": "results", "keys": ["results", "case_id", "case_expression", "case_number", "court", "case_type", "outcome", "level", "ranking"]},
    "brief": {"list": "results", "keys": ["result_count", "results", "case_id", "case_expression", "case_number", "court", "case_type", "outcome", "level"]},
    "decisions": {"list": "datas", "keys": ["total_count", "datas", "id", "title", "date", "organizationName", "highlight"]},
    "decision": {"keys": ["id", "title", "date", "dateName", "organizationName", "filepath"]},
    "case": {"required": null,
             "keys": ["case_expression", "case_number", "court", "outcome", "judgment_date", "pub_info", "holdings", "summary",
                      "ref_laws", "ref_cases", "fulltext", "attached_text", "attached", "history_cases", "restricted"]}
  }
}
